# Copy this file to .env and change every password before first start.

COMPOSE_PROJECT_NAME=woc-wow
DOCKER_IMAGE_TAG=master
DOCKER_PLATFORM=linux/amd64
DOCKER_WORLD_IMAGE=acore/ac-wotlk-worldserver:ahbot-autobalance
DOCKER_WORLD_PLATFORM=linux/amd64

# Synology LAN IP, for example 192.168.1.50.
LAN_IP=192.168.1.50

# Public LAN-facing ports. Keep these LAN-only in your router/firewall.
DOCKER_AUTH_EXTERNAL_PORT=3724
DOCKER_WORLD_EXTERNAL_PORT=8085
PORTAL_EXTERNAL_PORT=8090

# Do not publish MySQL or SOAP in the first version.
DOCKER_DB_ROOT_PASSWORD=change-this-long-random-password

# AzerothCore official images currently run as acore by default.
DOCKER_USER=acore

# Visible persistent storage under this project directory.
DOCKER_VOL_DB=./volumes/mysql
DOCKER_VOL_CLIENT_DATA=./volumes/client-data
PORTAL_DOWNLOADS_DIR=./portal-downloads
